@using TodoWarmup.Models;


<li>[@(Todo.IsDone ? "x" : " ")] @Todo.Text <button @onclick="Delete">Delete</button></li>

@code
{
  [Parameter]
  public TodoItem Todo { get; set; } = default!;

  [Parameter]
  public EventCallback<Guid> OnDelete { get; set; }

  private async Task Delete()
  {
    await OnDelete.InvokeAsync(Todo.Id);
  }
}
