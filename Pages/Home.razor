@page "/"
@using TodoWarmup.Models;
@using TodoWarmup.Components;

<PageTitle>Todo - Warmup</PageTitle>
<Input OnAdd="AddTodo" />
<Items Todos="todos" OnDelete="DeleteTodo" />


@code {
  private List<TodoItem> todos =
    [
  new TodoItem{Id = Guid.NewGuid(), Text = "Köpa bröd", IsDone = false},
  new TodoItem{Id = Guid.NewGuid(), Text = "Bädda sängen", IsDone = false},
  new TodoItem{Id = Guid.NewGuid(), Text = "Torka bordet", IsDone = false}
    ];
  private void AddTodo(string text)
  {
    todos.Add(new TodoItem { Id = Guid.NewGuid(), Text = text });
  }
  private void DeleteTodo(Guid id)
  {
    todos.RemoveAll(t => t.Id == id); ;
  }

}
